# Cache policy untuk deployment Apache/XAMPP.
# File ini ikut ter-copy ke folder build (public assets).
#
# Syarat XAMPP:
# - mod_headers dan mod_rewrite aktif di httpd.conf
# - AllowOverride All untuk folder document root
#
# Hash routing (/#/home) tidak butuh rewrite, tetapi fallback ini aman
# untuk path tanpa hash.

<IfModule mod_headers.c>
  # HTML harus selalu revalidasi agar menunjuk bundle terbaru.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Dipakai AppUpdateService untuk mendeteksi deploy baru.
  <Files "version.json">
    Header set Cache-Control "no-store"
    Header set Pragma "no-cache"
  </Files>

  # Peta remote Native Federation: bisa berubah tiap deploy, jangan disimpan.
  <Files "federation.manifest.json">
    Header set Cache-Control "no-store"
    Header set Pragma "no-cache"
  </Files>

  # Entry remote host: harus revalidasi agar menunjuk chunk terbaru.
  <Files "remoteEntry.json">
    Header set Cache-Control "no-cache"
  </Files>

  # Hanya aset ber-hash dari Angular yang boleh di-cache selamanya.
  # Termasuk shared external Native Federation (_angular_*.js).
  <FilesMatch "^(main|polyfills|styles|chunk|vendor|runtime)-[A-Za-z0-9_-]+\.(js|css)$|^_angular_[A-Za-z0-9_.-]+\.js$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Aset media/font hasil build juga ber-hash.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#/media/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Gambar/aset statis non-hash (termasuk favicon) di luar /media/.
  <If "%{REQUEST_URI} =~ m#\.(png|jpe?g|gif|svg|webp|ico|woff2?)$# && %{REQUEST_URI} !~ m#/media/#">
    Header set Cache-Control "public, max-age=86400"
  </If>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
