# Contoh konfigurasi Nginx untuk staging/production di subfolder.
#
# Build staging memakai base href /ivendor-staging/ dan hasilnya disalin ke:
#   /var/www/ivendor-staging/
# Build production (base href /) bisa memakai vhost terpisah atau root /.
#
# Remote Native Federation profile-management diasumsikan disajikan
# same-origin di bawah base host:
#   staging    : /ivendor-staging/remotes/profile-management/
#   production : /remotes/profile-management/
# Contoh header untuk artefak remote ada di file ini dan di
# deploy/README.md repo remote. Remote tidak memakai .htaccess.
#
# Sesuaikan server_name, root, dan SSL sebelum dipakai.

server {
    listen 80;
    listen [::]:80;
    server_name example.aio.co.id;

    # root adalah folder INDUK yang berisi folder aplikasi.
    root /var/www;
    index index.html;

    # --- Artefak host -------------------------------------------------------
    # Exact match selalu menang atas location prefix di bawah.

    # Jangan cache HTML: harus selalu menunjuk bundle hasil deploy terbaru.
    location = /ivendor-staging/index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri =404;
    }

    # Dicek berkala oleh AppUpdateService.
    location = /ivendor-staging/version.json {
        add_header Cache-Control "no-store" always;
        add_header Pragma "no-cache" always;
        expires -1;
        try_files $uri =404;
    }

    # Peta remote Native Federation: berubah tiap deploy, jangan disimpan.
    location = /ivendor-staging/federation.manifest.json {
        add_header Cache-Control "no-store" always;
        add_header Pragma "no-cache" always;
        expires -1;
        try_files $uri =404;
    }

    # Entry remote host: harus revalidasi agar menunjuk chunk terbaru.
    location = /ivendor-staging/remoteEntry.json {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # --- Artefak remote profile-management ---------------------------------
    # Hanya berlaku bila remote di-upload ke root yang sama
    # (/var/www/ivendor-staging/remotes/profile-management/).

    location = /ivendor-staging/remotes/profile-management/index.html {
        add_header Cache-Control "no-cache, must-revalidate" always;
        try_files $uri =404;
    }

    location = /ivendor-staging/remotes/profile-management/version.json {
        add_header Cache-Control "no-store" always;
        add_header Pragma "no-cache" always;
        expires -1;
        try_files $uri =404;
    }

    location = /ivendor-staging/remotes/profile-management/remoteEntry.json {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Aset publik remote (template PDF, favicon) namanya tidak ber-hash.
    location /ivendor-staging/remotes/profile-management/documents/ {
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    # Chunk remote ber-hash boleh di-cache selamanya.
    location /ivendor-staging/remotes/profile-management/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # --- Aset host ----------------------------------------------------------

    # Aset ber-hash dari Angular boleh di-cache selamanya.
    # Termasuk shared external Native Federation (_angular_*.js).
    location ~ ^/ivendor-staging/((main|polyfills|styles|chunk|vendor|runtime)-[A-Za-z0-9_-]+\.(js|css)|_angular_[A-Za-z0-9_.-]+\.js)$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Media/font hasil build (nama ber-hash). ^~ agar tidak ditimpa regex gambar.
    location ^~ /ivendor-staging/media/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Gambar/aset statis non-hash (termasuk favicon) di luar /media/.
    location ~* ^/ivendor-staging/(?!media/).*\.(png|jpe?g|gif|svg|webp|ico|woff2?)$ {
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    # Hash routing: fallback ini hanya untuk path tanpa hash.
    location /ivendor-staging/ {
        try_files $uri $uri/ /ivendor-staging/index.html;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
    gzip_min_length 1024;

    # Uncomment setelah SSL:
    # listen 443 ssl http2;
    # ssl_certificate     /etc/letsencrypt/live/example.aio.co.id/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/example.aio.co.id/privkey.pem;
}

# ---------------------------------------------------------------------------
